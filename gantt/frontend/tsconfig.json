{
  "compilerOptions": {
    "types": ["node"],
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext", "ES2015"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",

    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@components/*": ["components/*"],
      "@pages/*": ["pages/*"],
      "@api": ["api.ts"],
      "@api/*": ["api/*"],
      "@types/*": ["types/*"],
      "@utils/*": ["utils/*"],
      "@gantt/*": ["gantt/*"],
      "@styles/*": ["styles/*"],
      "@store/*": ["store/*"],
      "@repos/*": ["repos/*"],
      "@features/*": ["features/*"],
      "@sync/*": ["sync/*"]
    },

    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
